-- 缁冧範 2.3 瑙ｇ瓟
theorem solution_2_3 : 蠁 ^ 3 = 2 * 蠁 + 1 := by
  have h1 : 蠁 ^ 2 = 蠁 + 1 := phi_sq_eq_phi_add_one
  calc 
    蠁 ^ 3 = 蠁 * 蠁 ^ 2 := by ring
    _ = 蠁 * (蠁 + 1) := by rw [h1]
    _ = 蠁 ^ 2 + 蠁 := by ring
    _ = (蠁 + 1) + 蠁 := by rw [h1]
    _ = 2 * 蠁 + 1 := by ring

