section Solutions

-- 缁冧範 1.1 瑙ｇ瓟
theorem solution_1_1 (a b : 鈩? : a^3 - b^3 = (a - b) * (a^2 + a*b + b^2) := by
  calc
    a^3 - b^3 = (a - b) * (a^2 + a*b + b^2) := by ring

-- 缁冧範 1.2 瑙ｇ瓟
theorem solution_1_2 (a b : 鈩? (ha : 0 < a) (h : a < b) : a^2 < b^2 := by
  nlinarith [h, mul_pos ha (sub_pos.mpr h)]

-- 缁冧範 1.3 瑙ｇ瓟
theorem solution_1_3 {蠁 : 鈩潁 (h蠁 : 蠁^2 = 蠁 + 1) : 蠁^5 = 5*蠁 + 3 := by
  have h3 : 蠁^3 = 2*蠁 + 1 := by
    calc
      蠁^3 = 蠁 * 蠁^2 := by ring
      _ = 蠁 * (蠁 + 1) := by rw [h蠁]
      _ = 蠁^2 + 蠁 := by ring
      _ = (蠁 + 1) + 蠁 := by rw [h蠁]
      _ = 2*蠁 + 1 := by ring
  have h4 : 蠁^4 = 3*蠁 + 2 := by
    calc
      蠁^4 = 蠁 * 蠁^3 := by ring
      _ = 蠁 * (2*蠁 + 1) := by rw [h3]
      _ = 2*蠁^2 + 蠁 := by ring
      _ = 2*(蠁 + 1) + 蠁 := by rw [h蠁]
      _ = 3*蠁 + 2 := by ring
  calc
    蠁^5 = 蠁 * 蠁^4 := by ring
    _ = 蠁 * (3*蠁 + 2) := by rw [h4]
    _ = 3*蠁^2 + 2*蠁 := by ring
    _ = 3*(蠁 + 1) + 2*蠁 := by rw [h蠁]
    _ = 5*蠁 + 3 := by ring

-- 缁冧範 2.1 瑙ｇ瓟
theorem solution_2_1 (a b : 鈩? (h : a^2 + b^2 = 0) : a = 0 鈭?b = 0 := by
  have ha2 : a^2 鈮?0 := sq_nonneg a
  have hb2 : b^2 鈮?0 := sq_nonneg b
  have ha2_zero : a^2 = 0 := by
    linarith [h, ha2, hb2]
  have hb2_zero : b^2 = 0 := by
    linarith [h, ha2, hb2]
  have ha_zero : a = 0 := pow_eq_zero ha2_zero
  have hb_zero : b = 0 := pow_eq_zero hb2_zero
  exact 鉄╤a_zero, hb_zero鉄?
-- 缁冧範 2.2 瑙ｇ瓟
theorem solution_2_2 (a b c d : 鈩? : (a^2 + b^2) * (c^2 + d^2) 鈮?(a*c + b*d)^2 := by
  have h : (a^2 + b^2) * (c^2 + d^2) - (a*c + b*d)^2 = (a*d - b*c)^2 := by
    ring
  have h2 : (a*d - b*c)^2 鈮?0 := sq_nonneg (a*d - b*c)
  linarith [h, h2]

-- 缁冧範 3.2 瑙ｇ瓟
theorem solution_3_2 (x : 鈩? (h : x^3 = x) : x = 0 鈭?x = 1 := by
  by_cases hx : x 鈮?1
  路 -- x 鈮?1锛屾墍浠?x = 0 鎴?x = 1
    interval_cases x <;> simp
  路 -- x > 1锛岃瘉鏄庝笉鍙兘
    have h2 : x 鈮?2 := by omega
    have h3 : x^3 > x := by
      have h4 : x^2 > 1 := by nlinarith [h2]
      nlinarith [h2, h4]
    linarith

-- 缁冧範 4.1 瑙ｇ瓟
theorem solution_4_1 (n : 鈩? : 鈭?i in Finset.range (n + 1), (2 : 鈩?^i = 2^(n + 1) - 1 := by
  induction n with
  | zero =>
    simp
  | succ n ih =>
    rw [Finset.sum_range_succ, ih]
    ring_nf
    omega

-- 缁冧範 5.1 瑙ｇ瓟鎬濊矾
theorem solution_5_1 (a b c : 鈩? (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    (a + b + c) * (1/a + 1/b + 1/c) 鈮?9 := by
  field_simp
  nlinarith [sq_nonneg (a*b - b*c), sq_nonneg (b*c - c*a), sq_nonneg (c*a - a*b),
            sq_nonneg (a - b), sq_nonneg (b - c), sq_nonneg (c - a),
            mul_pos ha hb, mul_pos hb hc, mul_pos ha hc]

-- 缁冧範 5.2 瑙ｇ瓟
theorem solution_5_2 (a b : 鈩? (ha : a 鈮?0) (hb : b 鈮?0) :
    ((a + b)^2 - (a - b)^2) / (4 * a * b) = 1 := by
  have h1 : (a + b)^2 - (a - b)^2 = 4 * a * b := by
    ring
  rw [h1]
  field_simp [ha, hb]

